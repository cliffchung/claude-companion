{
  "//": "Optional: merge this into ~/.claude/settings.json to push INSTANT state changes to the bridge.",
  "//2": "Without it the bridge still works via polling (every COMPANION_POLL_SECONDS). Replace ABSOLUTE_PATH.",
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "async": true, "command": "ABSOLUTE_PATH/claude-companion/bridge/hooks/cc-state.sh working" } ] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "async": true, "command": "ABSOLUTE_PATH/claude-companion/bridge/hooks/cc-state.sh working" } ] }
    ],
    "Notification": [
      { "matcher": "permission_prompt", "hooks": [ { "type": "command", "async": true, "command": "ABSOLUTE_PATH/claude-companion/bridge/hooks/cc-state.sh needs_input" } ] },
      { "matcher": "idle_prompt", "hooks": [ { "type": "command", "async": true, "command": "ABSOLUTE_PATH/claude-companion/bridge/hooks/cc-state.sh idle" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "async": true, "command": "ABSOLUTE_PATH/claude-companion/bridge/hooks/cc-state.sh done" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "async": true, "command": "ABSOLUTE_PATH/claude-companion/bridge/hooks/cc-state.sh end" } ] }
    ]
  }
}
