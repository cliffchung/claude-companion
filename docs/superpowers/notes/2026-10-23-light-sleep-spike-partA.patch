+#if DISPLAY_CTL_TEARDOWN
+/* `power spike recreate <n>`: n teardown/re-create cycles, the heap after each */
+static int cmd_spike_recreate(int n)
+{
+    if (power_state() != PS_ACTIVE) { printf("spike: only while active\n"); return 1; }
+    power_hold(POWER_HOLD_BENCH, true);   /* the ladder must not dim it under us */
+    size_t i0 = heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
+    size_t p0 = heap_caps_get_free_size(MALLOC_CAP_SPIRAM);
+    printf("spike: before: internal=%u psram=%u\n", (unsigned)i0, (unsigned)p0);
+    uint32_t slowest = 0;
+    int ok = 0;
+    for (int i = 0; i < n; i++) {
+        esp_err_t e = display_ctl_teardown();
+        if (e == ESP_OK) {
+            vTaskDelay(pdMS_TO_TICKS(200));
+            e = display_ctl_recreate();
+        }
+        if (e != ESP_OK) { printf("spike: cycle %d failed: %s\n", i + 1, esp_err_to_name(e)); break; }
+        ok++;
+        uint32_t ms = display_ctl_recreate_ms();
+        if (ms > slowest) slowest = ms;
+        vTaskDelay(pdMS_TO_TICKS(300));   /* let freed memory settle (async deletes) */
+        printf("spike: cycle %d: picture %u ms internal=%u psram=%u touch after teardown: %s\n", i + 1, (unsigned)ms,
+               (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT),
+               (unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM),
+               display_ctl_touch_after_teardown() == 1 ? "ok" : "dead");
+    }
+    power_hold(POWER_HOLD_BENCH, false);
+    printf("spike: %d/%d cycles, slowest wake-to-picture %u ms\n", ok, n, (unsigned)slowest);
+    return ok == n ? 0 : 1;
+}
+#endif
