+#include "esp_timer.h"
+#include "esp_heap_caps.h"
+#include "settings/settings.h"
+#include "ui/ui.h"
+
+static lv_display_t *s_placeholder;
+static SemaphoreHandle_t s_done;
+static esp_err_t s_result;
+static uint32_t s_recreate_ms;
+static int s_touch_after = -1;
+static bool s_low;                  /* display_ctl_low_power(true) in force */
+
+uint32_t display_ctl_recreate_ms(void) { return s_recreate_ms; }
+int display_ctl_touch_after_teardown(void) { return s_touch_after; }
+
+/* LVGL task */
+static void teardown_async(void *arg)
+{
+    (void)arg;
+    s_result = ESP_OK;
+    if (s_torn) goto out;
+    lv_display_t *disp = lv_display_get_default();
+    lv_indev_t *in = display_ctl_indev();
+    esp_lcd_touch_handle_t tp = display_ctl_touch();
+    /* the placeholder first: it becomes the default when the real display goes */
+    s_placeholder = lv_display_create(1, 1);
+    if (!s_placeholder) { s_result = ESP_ERR_NO_MEM; goto out; }
+    lv_display_delete_refr_timer(s_placeholder);
+    esp_lcd_panel_handle_t panel = display_ctl_panel();
+    if (in) lvgl_port_remove_touch(in);
+    /* no DPI "done" callback may reach the port's context once it is freed */
+    const esp_lcd_dpi_panel_event_callbacks_t none = { 0 };
+    if (panel) esp_lcd_dpi_panel_register_event_callbacks(panel, &none, NULL);
+    if (disp) lvgl_port_remove_disp(disp);
+    lv_display_set_default(s_placeholder);
+    bsp_display_delete();
+    /* v2: the ST7123 is one chip; does its touch side still answer with the panel deleted? */
+    bool alive = tp && esp_lcd_touch_read_data(tp) == ESP_OK;
+    s_touch_after = alive ? 1 : 0;
+    ESP_LOGI(TAG, "touch after teardown: %s", alive ? "ok" : "dead");
+    if (tp && !alive) { esp_lcd_touch_del(tp); tp = NULL; }
+    s_own = true;
+    s_indev = NULL;
+    s_tp = tp;
+    s_torn = true;
+out:
+    xSemaphoreGive(s_done);
+}
+
+/* LVGL task */
+static void recreate_async(void *arg)
+{
+    (void)arg;
+    s_result = ESP_OK;
+    if (!s_torn) goto out;
+    int64_t t0 = esp_timer_get_time();
+    /* the BSP default lane rate on v2; only the v3 ST7121 needs 965 Mbps */
+    bsp_display_config_t dc = { .dsi_bus = { .phy_clk_src = 0, .lane_bit_rate_mbps = BSP_LCD_MIPI_DSI_LANE_BITRATE_MBPS } };
+    if (display_ctl_board_version() == 3) dc.dsi_bus.lane_bit_rate_mbps = 965;
+    bsp_lcd_handles_t h = { 0 };
+    s_result = bsp_display_new_with_handles(&dc, &h);
+    if (s_result != ESP_OK) { ESP_LOGE(TAG, "re-create: panel: %s", esp_err_to_name(s_result)); goto out; }
+    esp_lcd_panel_disp_on_off(h.panel, true);
+    /* app_main's display_init_early config (Plan 1) */
+    const lvgl_port_display_cfg_t cfg = {
+        .io_handle = h.io,
+        .panel_handle = h.panel,
+        .buffer_size = BSP_LCD_H_RES * 50,
+        .double_buffer = true,
+        .hres = BSP_LCD_H_RES,
+        .vres = BSP_LCD_V_RES,
+        .flags = { .buff_dma = false, .buff_spiram = true, .sw_rotate = true, .swap_bytes = BSP_LCD_BIGENDIAN },
+    };
+    const lvgl_port_display_dsi_cfg_t dsi = { .flags = { .avoid_tearing = false } };
+    lv_display_t *disp = lvgl_port_add_disp_dsi(&cfg, &dsi);
+    if (!disp) { s_result = ESP_ERR_NO_MEM; ESP_LOGE(TAG, "re-create: lvgl display failed"); goto out; }
+    lv_display_set_default(disp);
+    lv_display_set_rotation(disp, (lv_display_rotation_t)(g_settings.rotation & 3));
+    if (!s_tp && bsp_touch_new(NULL, &s_tp) != ESP_OK) s_tp = NULL;
+    lv_indev_t *in = NULL;
+    if (s_tp) {
+        const lvgl_port_touch_cfg_t tc = { .disp = disp, .handle = s_tp };
+        in = lvgl_port_add_touch(&tc);
+    }
+    /* indevs the old display left without one (the console's virtual pointer) */
+    for (lv_indev_t *i = lv_indev_get_next(NULL); i; i = lv_indev_get_next(i))
+        if (!lv_indev_get_display(i)) lv_indev_set_display(i, disp);
+    s_indev = in;
+    if (s_placeholder) { lv_display_delete(s_placeholder); s_placeholder = NULL; }
+    s_torn = false;
+    ui_display_recreated(in);
+    if (s_hook) s_hook(in);
+    lv_refr_now(disp);
+    s_recreate_ms = (uint32_t)((esp_timer_get_time() - t0) / 1000);
+    ESP_LOGI(TAG, "re-created in %u ms", (unsigned)s_recreate_ms);
+out:
+    xSemaphoreGive(s_done);
+}
+
+static esp_err_t run_on_lvgl(lv_async_cb_t cb)
+{
+    if (!s_done) s_done = xSemaphoreCreateBinary();
+    if (!s_done) return ESP_ERR_NO_MEM;
+    xSemaphoreTake(s_done, 0);
+    if (!bsp_display_lock(5000)) return ESP_ERR_TIMEOUT;
+    lv_result_t r = lv_async_call(cb, NULL);
+    bsp_display_unlock();
+    if (r != LV_RESULT_OK) return ESP_ERR_NO_MEM;
+    lvgl_port_task_wake(LVGL_PORT_EVENT_USER, NULL);   /* it may be sleeping its 500 ms */
+    if (xSemaphoreTake(s_done, pdMS_TO_TICKS(10000)) != pdTRUE) return ESP_ERR_TIMEOUT;
+    return s_result;
+}
+
+esp_err_t display_ctl_teardown(void) { return run_on_lvgl(teardown_async); }
+esp_err_t display_ctl_recreate(void) { return run_on_lvgl(recreate_async); }
+
+esp_err_t display_ctl_low_power(bool on, bool light_sleep)
+{
+    if (on == s_low) return ESP_OK;
+    esp_err_t e;
+    if (on) {
+        e = display_ctl_teardown();
+        if (e != ESP_OK) return e;
+        esp_pm_config_t pm = { .max_freq_mhz = 360, .min_freq_mhz = 40, .light_sleep_enable = light_sleep };
+#if CONFIG_CC_LIGHT_SLEEP_SPIKE
+        if (light_sleep) {
+            gpio_wakeup_enable(GPIO_NUM_50, GPIO_INTR_LOW_LEVEL);   /* the keyboard's INT */
+            if (display_ctl_board_version() == 1) gpio_wakeup_enable(BSP_LCD_TOUCH_INT, GPIO_INTR_LOW_LEVEL);
+            esp_sleep_enable_gpio_wakeup();
+        }
+#else
+        pm.light_sleep_enable = false;
+#endif
+        e = esp_pm_configure(&pm);
+        if (s_pm_max) esp_pm_lock_release(s_pm_max);
+        s_low = true;
+        ESP_LOGI(TAG, "low power: display torn down, pm 360/40%s: %s", pm.light_sleep_enable ? " + light sleep" : "",
+                 esp_err_to_name(e));
+        return ESP_OK;
+    }
+    if (s_pm_max) esp_pm_lock_acquire(s_pm_max);   /* first: the re-create runs at full speed */
+    esp_pm_config_t pm = { .max_freq_mhz = 360, .min_freq_mhz = 40, .light_sleep_enable = false };
+    esp_pm_configure(&pm);
+#if CONFIG_CC_LIGHT_SLEEP_SPIKE
+    gpio_wakeup_disable(GPIO_NUM_50);
+    if (display_ctl_board_version() == 1) {
+        gpio_wakeup_disable(BSP_LCD_TOUCH_INT);
+    }
+#endif
+    s_low = false;
+    e = display_ctl_recreate();
+    /* v1: bsp_touch_new sets GPIO23 back to output-low; the INT ISR needs it as an input again */
+    if (display_ctl_board_version() == 1 && s_touch_isr) display_ctl_touch_int_init(s_touch_isr);
+    return e;
+}
+#endif
