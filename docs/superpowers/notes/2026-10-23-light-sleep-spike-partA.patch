+/* Task 6: Deep idle tears the display down and lets the CPU drop to 40 MHz; in the spike build
+   with pw_light_sleep on battery, Off does too, with light sleep. Leaving goes through leave_dark. */
+static void low_power_step(void)
+{
+#if DISPLAY_CTL_TEARDOWN
+    bool want = false, ls = false;
+    if (s_dark && s_state != PS_HIBERNATE && !s_wake_pending) {
+#if CONFIG_CC_DEEP_IDLE_TEARDOWN
+        if (s_state == PS_DEEP_IDLE) want = true;
+#endif
+#if CONFIG_CC_LIGHT_SLEEP_SPIKE
+        int pct;
+        bool chg;
+        if (g_settings.pw_light_sleep && on_battery_now(&pct, &chg)) want = ls = true;
+#endif
+    }
+    if (!want && s_low && s_dark && !s_wake_pending) {
+        /* still dark but no longer wanted (USB back during spike light sleep): the display comes
+           back with the panel off, so the console works again */
+        display_ctl_low_power(false, false);
+        s_low = false;
+        display_ctl_panel_on(false);
+        return;
+    }
+    if (!want || s_low) return;   /* waking is leave_dark's job */
+    esp_err_t e = display_ctl_low_power(true, ls);
+    if (e != ESP_OK) { ESP_LOGE(TAG, "display teardown: %s", esp_err_to_name(e)); return; }
+    s_low = true;
+#endif
 }
 
