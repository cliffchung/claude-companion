+/* ---- PM lock and display teardown (Plan 2 Task 6) ------------------------- */
+
+#if CONFIG_PM_ENABLE
+static esp_pm_lock_handle_t s_pm_max;   /* CPU_FREQ_MAX, held except in Deep idle */
+#endif
+
+void display_ctl_pm_init(void)
+{
+#if CONFIG_PM_ENABLE
+    if (s_pm_max) return;
+    if (esp_pm_lock_create(ESP_PM_CPU_FREQ_MAX, 0, "power", &s_pm_max) == ESP_OK) esp_pm_lock_acquire(s_pm_max);
+    /* min 40 MHz from now on: only the lock above (and the display's own) keeps the CPU at 360 */
+    esp_pm_config_t pm = { .max_freq_mhz = 360, .min_freq_mhz = 40, .light_sleep_enable = false };
